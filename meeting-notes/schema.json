{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MeetingNote",
  "description": "Structured meeting minutes generated by the meeting-notes skill",
  "type": "object",
  "required": ["meeting_id", "title", "date", "participants", "agenda", "metadata"],
  "properties": {
    "meeting_id": {
      "type": "string",
      "description": "Unique identifier. Auto-generated as SHA-256(title:date)[:12] by assemble.py if empty"
    },
    "title": {
      "type": "string",
      "description": "Meeting title"
    },
    "date": {
      "type": "string",
      "format": "date-time",
      "description": "Meeting start date/time in ISO 8601"
    },
    "duration_seconds": {
      "type": "integer",
      "description": "Meeting duration in seconds"
    },
    "meeting_type": {
      "type": "string",
      "enum": ["regular", "ad_hoc", "review", "decision", "informational"],
      "description": "Type of meeting"
    },
    "context": {
      "type": "string",
      "description": "Project, initiative, or background this meeting relates to"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["organizer", "decision_maker", "proposer", "reporter", "observer"]
          },
          "affiliation": { "type": "string" }
        }
      }
    },
    "participant_dynamics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "relation": {
            "type": "string",
            "enum": ["proposal_approval", "objection_reproposal", "delegation", "question_answer", "report", "instruction"]
          },
          "topic": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "agenda": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["decided", "pending", "rejected", "informational"]
          },
          "summary": { "type": "string" },
          "speakers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "utterances": {
            "type": "array",
            "description": "Key statements by speakers relevant to this topic, copied verbatim from the transcript",
            "items": {
              "type": "object",
              "required": ["speaker", "text"],
              "properties": {
                "speaker": { "type": "string" },
                "text": { "type": "string" },
                "timestamp": { "type": "string" }
              }
            }
          },
          "discussion_points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["what", "why"],
              "properties": {
                "what": { "type": "string" },
                "why": { "type": "string" },
                "alternatives_considered": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["option", "rejected_because"],
                    "properties": {
                      "option": { "type": "string" },
                      "rejected_because": { "type": "string" }
                    }
                  }
                },
                "decided_by": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          },
          "action_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["owner", "task"],
              "properties": {
                "owner": { "type": "string" },
                "task": { "type": "string" },
                "due": { "type": "string", "description": "Deadline as free text (e.g. \"2026-04-17\", \"next Friday\")" },
                "context": { "type": "string" }
              }
            }
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["issue"],
              "properties": {
                "issue": { "type": "string" },
                "blocker": { "type": "string" },
                "carry_forward_to": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "key_takeaways": {
      "type": "array",
      "items": { "type": "string" }
    },
    "raw_transcript": {
      "type": "string",
      "description": "Full original transcript text preserved for archival (populated by assemble.py, not by extraction)"
    },
    "metadata": {
      "type": "object",
      "required": ["generated_by", "generated_at", "model"],
      "properties": {
        "source_audio": { "type": "string" },
        "source_transcript": { "type": "string" },
        "generated_by": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "model": { "type": "string" }
      }
    }
  }
}
